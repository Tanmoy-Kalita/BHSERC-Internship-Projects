{
  "manifest_version": 3,
  "name": "Chat Saver",
  "version": "1.0.0",
  "description": "Save, organize, and export conversations from ChatGPT, Claude, Bard, and other AI chat platforms. Tag, search, and sync locally.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chat Saver"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "*://chat.openai.com/*",
        "*://chatgpt.com/*",
        "*://claude.ai/*",
        "*://bard.google.com/*",
        "*://gemini.google.com/*",
        "*://chat.mistral.ai/*",
        "*://pi.ai/*",
        "*://you.com/*",
        "*://perplexity.ai/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "permissions": [
    "storage",
    "sidePanel",
    "scripting",
    "activeTab",
    "tabs",
    "downloads",
    "clipboardWrite"
  ],
  "host_permissions": [
    "*://chat.openai.com/*",
    "*://chatgpt.com/*",
    "*://claude.ai/*",
    "*://bard.google.com/*",
    "*://gemini.google.com/*",
    "*://chat.mistral.ai/*",
    "*://pi.ai/*",
    "*://you.com/*",
    "*://perplexity.ai/*"
  ],
  "commands": {
    "save-chat": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Save current conversation"
    }
  }
}