{
  "manifest_version": 3,
  "name": "Chat Saver",
  "version": "1.0.0",
  "description": "Extract and save conversations from AI chat platforms",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Chat Saver"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "open-panel": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Open Chat Saver panel"
    }
  }
}
