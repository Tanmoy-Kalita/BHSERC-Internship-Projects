{
  "manifest_version": 3,
  "name": "One-Minute Reel Cut",
  "version": "1.0.0",
  "description": "Cut your videos to exactly 1 minute. Trim any video, preview the selection, and export the clipped segment as a new file.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "One-Minute Reel Cut"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "storage",
    "downloads",
    "activeTab",
    "scripting",
    "video"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "open-panel": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "Open Reel Cut panel"
    }
  }
}
