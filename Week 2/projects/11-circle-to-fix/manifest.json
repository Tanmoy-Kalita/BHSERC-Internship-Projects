{
  "manifest_version": 3,
  "name": "Circle to Fix",
  "version": "1.0.0",
  "description": "Circle any element on a webpage to get AI-powered fixes, code suggestions, and explanations. Perfect for developers debugging UI issues.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Circle to Fix"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "permissions": [
    "storage",
    "scripting",
    "activeTab",
    "tabs",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": ["injected.js"],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "toggle-circle-mode": {
      "suggested_key": { "default": "Alt+Shift+C" },
      "description": "Toggle circle/annotation mode"
    }
  }
}