{
  "manifest_version": 3,
  "name": "Tab Goblin",
  "version": "1.0.0",
  "description": "Smart tab manager with grouping, search, suspension, session save/restore, and keyboard shortcuts. Organize your browser tabs like a pro.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Tab Goblin"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "sidePanel",
    "scripting",
    "activeTab",
    "windows",
    "downloads",
    "clipboardWrite"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "open-panel": {
      "suggested_key": { "default": "Alt+Shift+T" },
      "description": "Open Tab Goblin panel"
    },
    "suspend-tabs": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Suspend all tabs in current window"
    },
    "search-tabs": {
      "suggested_key": { "default": "Alt+Shift+F" },
      "description": "Focus search"
    }
  }
}